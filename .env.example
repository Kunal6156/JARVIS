# --- Brain: "ollama" (local), "omniroute"/"openai" (any OpenAI-compatible gateway) or "anthropic" ---
JARVIS_PROVIDER=anthropic
ANTHROPIC_API_KEY=
JARVIS_ANTHROPIC_MODEL=claude-sonnet-5-5
# For local: install Ollama, then `ollama pull qwen2.5:7b` (needs a tool-calling model)
OLLAMA_URL=http://localhost:11434
# Use the exact name from `ollama list`. The model must support tool calling.
JARVIS_OLLAMA_MODEL=gemma

# OmniRoute (or any OpenAI-compatible server). Copy URL, key and model/combo name from its dashboard.
JARVIS_OPENAI_BASE_URL=http://localhost:20128/v1
JARVIS_OPENAI_KEY=
JARVIS_OPENAI_MODEL=
# JARVIS_OPENAI_VISION_MODEL=
# JARVIS_LITE=auto   (1 = only ~28 core tools, best for small local models; 0 = all tools)
JARVIS_OLLAMA_VISION_MODEL=llava

# --- Voice ---
# wake = say "Jarvis, ..."   always = every sentence is a command   hotkey = press the key, then speak
JARVIS_LISTEN_MODE=wake
JARVIS_WAKE_WORD=jarvis,hey jarvis
JARVIS_HOTKEY=f9
JARVIS_WHISPER_MODEL=small.en
JARVIS_LANGUAGE=en
JARVIS_SESSION_SECONDS=25

# --- Safety ---
# Comma-separated tools that never ask for approval (run_command can never be auto-approved)
JARVIS_AUTO_APPROVE=
# Folder used for relative paths
# JARVIS_WORKSPACE=C:\Users\you\Documents

# --- Speed ---
# Speak sentence by sentence while the model is still writing (1 = on)
JARVIS_STREAM=1
JARVIS_STOP_KEY=f8
# JARVIS_TTS_VOICE=zira        (see: python main.py --voices)

# --- Dashboard ---
JARVIS_DASHBOARD_PORT=8765

# --- Optional phone calls / SMS (your own Twilio account, costs money) ---
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=+1234567890

# --- Natural voice (pip install edge-tts pygame). Needs internet; falls back to the built-in voice offline ---
# JARVIS_TTS_ENGINE=edge
# JARVIS_EDGE_VOICE=en-GB-RyanNeural

# --- Languages: en | hi | auto (English, Hindi and Hinglish; uses the multilingual Whisper model automatically) ---
# JARVIS_LANGUAGE=auto
# JARVIS_WHISPER_MODEL=small
# JARVIS_EDGE_VOICE_HI=hi-IN-MadhurNeural

# --- Owner check: off | face | voice | either | both  (run --enroll-face / --enroll-voice first) ---
# JARVIS_AUTH=face
# JARVIS_AUTH_TTL=120

# --- Phone control (Telegram): create a bot with @BotFather, then run: python main.py --telegram ---
# TELEGRAM_TOKEN=
# TELEGRAM_ALLOWED_IDS=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Speed ---
# JARVIS_WHISPER_MODEL=base.en   (faster, a little less accurate)
# JARVIS_VISION_WIDTH=1024
